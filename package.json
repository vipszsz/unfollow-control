{
  "name": "unfollow-control",
  "productName": "Unfollow Control",
  "version": "1.2.0",
  "private": true,
  "description": "Veja quem não te segue de volta no Instagram a partir do export oficial. Sem login, sem internet.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,app -c blue,magenta \"vite\" \"wait-on tcp:5190 && cross-env VITE_DEV_SERVER_URL=http://localhost:5190 electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build --mode web && node scripts/name-web-build.cjs",
    "dist": "npm run build && electron-builder --win && npm run build:web && node scripts/checksums.cjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fflate": "^0.8.3",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "wait-on": "^9.5.1"
  },
  "author": "vipszsz",
  "license": "MIT",
  "homepage": "https://github.com/vipszsz/unfollow-control",
  "build": {
    "appId": "app.unfollowcontrol",
    "productName": "Unfollow Control",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "UnfollowControl-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unfollow Control",
      "deleteAppDataOnUninstall": false,
      "artifactName": "UnfollowControl-${version}-setup.${ext}"
    }
  }
}
