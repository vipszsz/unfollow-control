{
  "name": "unfollow-control",
  "productName": "Unfollow Control",
  "version": "0.1.0",
  "private": true,
  "description": "Veja quem não te segue de volta no Instagram a partir do export oficial. Sem login, sem internet.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,app -c blue,magenta \"vite\" \"wait-on tcp:5190 && cross-env VITE_DEV_SERVER_URL=http://localhost:5190 electron .\"",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "wait-on": "^9.5.1"
  }
}
